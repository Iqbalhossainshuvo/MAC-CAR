{
  "expo": {
    "name": "MAC CAR",
    "slug": "mac-car",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maccar.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7C5CFC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.maccar.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "MAC CAR",
      "shortName": "MAC CAR",
      "themeColor": "#F2F0FF",
      "backgroundColor": "#F2F0FF"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#F2F0FF"
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "maccar",
    "backgroundColor": "#F2F0FF"
  }
}
