    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test:backend": "node apps-script/test/test.js apps-script/Code.gs",
    "build:web": "expo export -p web",
    "test:payroll": "tsc --ignoreConfig --outDir .test-build --module commonjs --target es2020 --skipLibCheck --jsx react-jsx --esModuleInterop src/lib/payroll.ts && node tests/payroll.test.js",
    "test:money": "tsc --ignoreConfig --outDir .money-test --module commonjs --target es2020 --skipLibCheck --esModuleInterop src/lib/payroll.ts src/lib/format.ts src/lib/partners.ts; node scripts/money-test.js .money-test"
  },
  "private": true
